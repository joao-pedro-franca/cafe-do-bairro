{
  "name": "cafe-do-bairro-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "admin:hash": "node --experimental-strip-types src/gerar-senha.ts",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "start": "node dist/server.js",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
